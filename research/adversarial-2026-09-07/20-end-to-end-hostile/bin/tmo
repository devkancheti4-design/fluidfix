#!/bin/sh
# tmo SECONDS CMD... — no coreutils `timeout` on this host, so: perl alarm + nice.
# Runs the command in its own process group and SIGKILLs the group on expiry.
S="$1"; shift
exec nice -n 15 perl -e '
  my $s = shift @ARGV;
  my $pid = fork();
  if ($pid == 0) { setpgrp(0,0); exec @ARGV or die "exec: $!"; }
  $SIG{ALRM} = sub { kill(-9, $pid); waitpid($pid, 0); print STDERR "\n[tmo] TIMEOUT after ${s}s\n"; exit 124; };
  alarm($s);
  waitpid($pid, 0);
  my $rc = $?;
  alarm(0);
  exit($rc >> 8 ? $rc >> 8 : ($rc & 127 ? 128 + ($rc & 127) : 0));
' "$S" "$@"
