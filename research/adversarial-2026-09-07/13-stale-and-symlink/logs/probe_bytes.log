BITS: ['BUILT', 'AMB', 'UNREAD', 'NOTWIN', 'HIDDEN', 'CAPPED', 'REFUTED', 'SELF']
ACTS: ['SHIP', 'ADD_STATE', 'ADD_MATERIAL', 'RESHAPE', 'CHANGE_GRANULARITY', 'RAISE_BUDGET', 'HARVEST_COUNTEREXAMPLE', 'AUTHOR_SUCCESSOR']

BOM  -- byte AS DELIVERED (REFUTED)          byte=0x240 (576)  decide -> HARVEST_COUNTEREXAMPLE
BOM  -- byte AS IT SHOULD HAVE BEEN          byte=0x201 (513)  decide -> SHIP
SPAN -- byte at ship time (BUILT only)       byte=0x201 (513)  decide -> SHIP
