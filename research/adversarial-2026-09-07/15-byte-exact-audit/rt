#!/bin/sh
# rt SECONDS CMD...  — nice'd, hard-timeout run wrapper.
# This machine has no coreutils `timeout`; perl's alarm is the substitute.
# Kills the whole process group so a hung pytest child cannot outlive us.
S="$1"; shift
exec nice -n 15 perl -e '
  my $s = shift @ARGV;
  my $pid = fork();
  die "fork: $!" unless defined $pid;
  if ($pid == 0) { setpgrp(0,0); exec @ARGV or die "exec: $!"; }
  $SIG{ALRM} = sub { kill "KILL", -$pid; waitpid($pid,0); print STDERR "\n[rt] TIMEOUT after ${s}s\n"; exit 124; };
  alarm $s;
  waitpid($pid, 0);
  my $rc = $? >> 8;
  alarm 0;
  exit $rc;
' "$S" "$@"
