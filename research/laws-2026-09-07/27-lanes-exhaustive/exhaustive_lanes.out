  m=          True  EMIT=1              ADVANCE=0                HALT=0 (spec 0)
  m=         False  EMIT=0              ADVANCE=0                HALT=1 (spec 1)

== the C expression this Python is a port of ==
   docstring: 32-bit semantics of ((m - (m - 1)) + ((-m) >> 31))
   python HALT vs literal C-int32 evaluation, m in -1024..1023 plus INT32 extremes: 1 divergences -> [-2147483648]
     m=-2147483648: python HALT=1  C-int32 HALT=0

== mask_of / kind_of domain ==
  mask_of([0, 3]) = 9 = 0b1001
  mask_of([12]) = 4096 = 0b1000000000000
  mask_of([0, 1, 2, 3, 8, 9, 10, 11, 12]) = 7951 = 0b1111100001111
  mask_of([15]) = 32768 = 0b1000000000000000
  mask_of([1, 1, 1]) = 2 = 0b10
  mask_of([3, 1]) = 10 = 0b1010
  mask_of([1, 3]) = 10 = 0b1010
  mask_of([-1]) RAISES ValueError: negative shift count
  mask_of([16]) = 65536
  mask_of([64]) = 18446744073709551616
  mask_of([True]) = 2
  kind_of(0) = -1   <== EMIT of an empty mask
